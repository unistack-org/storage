# systemd-юнит VDUSE/NBD-демона unistord с keep-alive.
#
# Установка:
#   install -Dm644 deploy/unistord.service /etc/systemd/system/unistord.service
#   mkdir -p /etc/unistord && $EDITOR /etc/unistord/unistord.env   # UNISTORD_ARGS=...
#   systemctl daemon-reload && systemctl enable --now unistord
#
# Конфиг демона — переменная окружения UNISTORD_ARGS в
# /etc/unistord/unistord.env (EnvironmentFile), например:
#   UNISTORD_ARGS=-meta-dir /var/lib/unistord/meta -osd 1@/var/lib/unistord/osd1 \
#     -http 10.0.0.10:8443 -admin-token <токен клетки> -metrics 0.0.0.0:8080
# (токен в EnvironmentFile с правами 0600)
#
# Plan-safe restart (см. deploy/README.md): перед рестартом погасите
# гостевой I/O (unmount/quiesce), затем systemctl restart unistord.
# A device that died mid-I/O needs a guest-visible reset — the unit's
# Restart=always revives the daemon, not the stuck request.
#
# TLS: файлы сертификата читаются демоном при старте и при перезагрузке,
# кладите их туда, где_unit_ имеет право чтения (каталог внутри
# /etc/unistord подходит; ProtectSystem=strict не мешает чтению из /etc).
# systemd сам не шлёт SIGHUP, поэтому перезагрузить конфиг без рестарта
# (и без касания живых экспортов) так:
#   systemctl kill -s HUP unistord
#   # или curl -k -X POST https://<узел>:8443/v1/reload
#   # или unistorctl reload -http https://<узел>:8443
# SIGHUP перезагружает всё декларативное: сертификат и ключ, QoS-классы,
# crushmap, -create, GOGC; CA перечитывается только на старте (ротация
# CA = рестарт). Отчёт — в логе, в /v1/status (st.reload) и в
# unistor_reload. См. todos/runbook.md, раздел TLS.

[Unit]
Description=Unistack SDS daemon (unistord: OSD + NBD/VDUSE exports)
Documentation=file:/usr/share/doc/unistord/deploy-README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/unistord ${UNISTORD_ARGS}
EnvironmentFile=-/etc/unistord/unistord.env
Restart=always
RestartSec=1

# Модули ядра для экспорта. systemd выполняет ExecStartPre от root до
# основного процесса, поэтому непривилегированному демону не нужны права на
# modprobe (NoNewPrivileges остаётся). `-` = ошибка не валит юнит: модуль
# может быть встроен в ядро (built-in), тогда modprobe его не находит.
# Статическая загрузка на boot — modules-load.d/unistord.conf (надёжнее:
# работает и когда юнит стартует не через systemd, и до первой записи в
# /var/lib/unistord). Не добавлять ProtectKernelModules=yes — он блокирует
# загрузку модулей.
ExecStartPre=-/usr/sbin/modprobe -q vduse virtio_vdpa vdpa nbd

# The daemon must create and attach VDUSE devices.
DeviceAllow=/dev/vduse/control rw
DeviceAllow=char-vduse rw
# Kernel vDPA char devices the QEMU side opens (created by udev/systemd).
DeviceAllow=/dev/vhost-vdpa-* rw

# Guest memory fault isolation (deploy/README.md): the daemon survives
# SIGBUS from stale IOTLB mappings, so never convert faults into kills.
IgnoreSIGPIPE=yes

StateDirectory=unistord
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/unistord /etc/unistord
LimitNOFILE=1048576
OOMPolicy=continue
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
